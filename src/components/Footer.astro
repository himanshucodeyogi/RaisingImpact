---
---
<footer class="bg-[#0F172A] text-white/70 pt-16 pb-8 mt-auto">
  <div class="max-w-7xl mx-auto px-6">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10 pb-12 border-b border-white/10">
      <!-- Brand -->
      <div class="md:col-span-2">
        <div class="flex items-center gap-3 mb-4">
          <img src="/logo.png" alt="Raising Impact Logo" class="w-10 h-10 object-contain" />
          <span class="font-bold text-xl text-white font-montserrat">
            Raising<span class="text-[#10B981]">Impact</span>
          </span>
        </div>
        <p class="text-white/60 text-sm leading-relaxed max-w-xs">
          Bridging the gap between philanthropic intent and measurable social outcomes through rigorous, evidence-led research.
        </p>
        <div class="flex items-center gap-3 mt-6">
          <a href="https://linkedin.com" target="_blank" aria-label="LinkedIn"
            class="w-10 h-10 rounded-xl bg-white/10 hover:bg-[#10B981] flex items-center justify-center transition-colors">
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
          </a>
          <a href="https://twitter.com" target="_blank" aria-label="Twitter"
            class="w-10 h-10 rounded-xl bg-white/10 hover:bg-[#10B981] flex items-center justify-center transition-colors">
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.737-8.835L2.25 2.25H8.08l4.253 5.622zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
        </div>
      </div>

      <!-- Quick Links -->
      <div>
        <h4 class="text-white font-semibold mb-4 text-sm uppercase tracking-widest">Navigation</h4>
        <ul class="space-y-3">
          {[["Home","/"],["About","/about"],["Our Team","/team"],["Contact","/contact"]].map(([label,href])=>(
            <li><a href={href} class="text-sm text-white/60 hover:text-[#10B981] transition-colors">{label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h4 class="text-white font-semibold mb-4 text-sm uppercase tracking-widest">Contact</h4>
        <ul class="space-y-3 text-sm text-white/60">
          <li class="flex items-start gap-2">
            <svg class="w-4 h-4 text-[#10B981] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            info@raisingimpact.org
          </li>
          <li class="flex items-start gap-2">
            <svg class="w-4 h-4 text-[#10B981] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            New Delhi, India
          </li>
        </ul>
      </div>
    </div>

    <div class="flex flex-col md:flex-row items-center justify-between gap-4 pt-8">
      <p class="text-xs text-white/40">&copy; 2026 Raising Impact. All rights reserved.</p>
      <div class="flex items-center gap-4 text-xs text-white/40">
        <a href="/privacy" class="hover:text-[#10B981] transition-colors">Privacy Policy</a>
        <a href="/terms" class="hover:text-[#10B981] transition-colors">Terms of Service</a>
        <span>Built with rigour, driven by purpose.</span>
      </div>
    </div>
  </div>
</footer>
