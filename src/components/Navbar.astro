---
const navLinks = [
  { href: "/", label: "Home" },
  { href: "/about", label: "About" },
  { href: "/team", label: "Our Team" },
  { href: "/contact", label: "Contact" },
];
const current = Astro.url.pathname;
---

<header id="navbar" class="fixed top-0 left-0 w-full z-50 transition-all duration-300 py-4">
  <div class="max-w-7xl mx-auto px-6 md:px-12 flex items-center justify-between">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-3 group" id="navbar-logo">
      <img src="/logo.png" alt="Raising Impact Logo" class="w-12 h-12 object-contain group-hover:scale-110 transition-transform" />
      <div class="flex flex-col">
        <span class="font-black text-base text-white font-montserrat leading-tight tracking-wide">
          Raising<span class="text-[#C09D4B]">Impact</span>
        </span>
        <span class="text-[#C09D4B]/60 text-[9px] font-montserrat uppercase tracking-[0.2em]">raisingimpact.org</span>
      </div>
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden md:flex items-center gap-1" aria-label="Main navigation">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class={`px-4 py-2 text-sm font-semibold font-montserrat transition-all duration-200 relative ${
            current === link.href || (link.href !== "/" && current.startsWith(link.href))
              ? "text-[#C09D4B]"
              : "text-white/70 hover:text-white"
          }`}
        >
          {link.label}
          {(current === link.href || (link.href !== "/" && current.startsWith(link.href))) && (
            <span class="absolute bottom-0 left-4 right-4 h-px bg-[#C09D4B]"></span>
          )}
        </a>
      ))}
      <a
        href="/contact"
        id="navbar-partner-btn"
        class="ml-4 px-5 py-2.5 bg-[#C09D4B] text-white text-xs font-black rounded-lg font-montserrat tracking-wide shadow-md hover:bg-[#D2B980] hover:shadow-[#C09D4B]/30 transition-all duration-200 uppercase"
      >
        Partner With Us
      </a>
    </nav>

    <!-- Mobile Hamburger -->
    <button id="menu-btn" class="md:hidden text-white p-2 rounded-lg hover:bg-white/10" aria-label="Menu">
      <svg class="w-6 h-6" id="menu-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
      </svg>
    </button>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden md:hidden mt-2 mx-6 bg-[#0F2440]/98 backdrop-blur-md rounded-xl border border-white/10 p-4">
    {navLinks.map((link) => (
      <a
        href={link.href}
        class="block px-4 py-3 text-white/75 hover:text-[#C09D4B] hover:bg-white/5 rounded-lg text-sm font-semibold font-montserrat transition-all border-b border-white/5"
      >
        {link.label}
      </a>
    ))}
    <a href="/contact" class="block mt-3 px-4 py-3 bg-[#C09D4B] text-white rounded-lg text-sm font-black text-center font-montserrat uppercase tracking-wide">
      Partner With Us
    </a>
  </div>
</header>

<script>
  const navbar = document.getElementById('navbar')!;
  const menuBtn = document.getElementById('menu-btn')!;
  const mobileMenu = document.getElementById('mobile-menu')!;

  // Scroll effect — add dark navy bg on scroll
  window.addEventListener('scroll', () => {
    if (window.scrollY > 20) {
      navbar.classList.add('bg-[#0F2440]/97', 'backdrop-blur-md', 'shadow-2xl', 'py-2');
      navbar.classList.remove('py-4');
    } else {
      navbar.classList.remove('bg-[#0F2440]/97', 'backdrop-blur-md', 'shadow-2xl', 'py-2');
      navbar.classList.add('py-4');
    }
  });

  // Mobile toggle
  menuBtn.addEventListener('click', () => {
    mobileMenu.classList.toggle('hidden');
  });
</script>
