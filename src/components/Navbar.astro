---
const navLinks = [
  { href: "/", label: "Home" },
  { href: "/about", label: "About" },
  { href: "/team", label: "Our Team" },
  { href: "/contact", label: "Contact" },
];
const current = Astro.url.pathname;
---

<header id="navbar" class="fixed top-0 left-0 w-full z-50 transition-all duration-300 py-3 md:py-4 bg-white border-b border-[#E8E0D0]">
  <div class="max-w-7xl mx-auto px-5 sm:px-8 md:px-12 flex items-center justify-between">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2 md:gap-3 group flex-shrink-0" id="navbar-logo">
      <img src="/logo.png" alt="Raising Impact Logo" class="w-10 h-10 md:w-12 md:h-12 object-contain group-hover:scale-110 transition-transform" />
      <div class="flex flex-col">
        <span class="font-black text-sm md:text-base text-[#0F2440] font-montserrat leading-tight tracking-wide">
          Raising<span class="text-[#C09D4B]">Impact</span>
        </span>
        <span class="hidden sm:block text-[#C09D4B]/80 text-[8px] font-montserrat uppercase tracking-[0.2em]">raisingimpact.org</span>
      </div>
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden md:flex items-center gap-1" aria-label="Main navigation">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class={`px-4 py-2 text-sm font-semibold font-montserrat transition-all duration-200 relative ${
            current === link.href || (link.href !== "/" && current.startsWith(link.href))
              ? "text-[#C09D4B]"
              : "text-[#2D3A4A] hover:text-[#0F2440]"
          }`}
        >
          {link.label}
          {(current === link.href || (link.href !== "/" && current.startsWith(link.href))) && (
            <span class="absolute bottom-0 left-4 right-4 h-px bg-[#C09D4B]"></span>
          )}
        </a>
      ))}
      <a
        href="/contact"
        id="navbar-partner-btn"
        class="ml-4 px-5 py-2.5 bg-[#C09D4B] text-white text-xs font-black rounded-lg font-montserrat tracking-wide shadow-md hover:bg-[#D2B980] hover:shadow-[#C09D4B]/30 transition-all duration-200 uppercase"
      >
        Partner With Us
      </a>
    </nav>

    <!-- Mobile Hamburger -->
    <button id="menu-btn" class="md:hidden text-[#0F2440] p-2 rounded-lg hover:bg-gray-100 transition-colors" aria-label="Open menu">
      <svg class="w-6 h-6" id="icon-open" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
      </svg>
      <svg class="w-6 h-6 hidden" id="icon-close" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>
  </div>

  <!-- Mobile Menu — full dropdown -->
  <div id="mobile-menu" class="hidden md:hidden mx-4 mt-2 bg-white rounded-xl border border-[#E8E0D0] overflow-hidden shadow-xl">
    <div class="p-2">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class={`flex items-center gap-3 px-4 py-3 rounded-lg text-sm font-semibold font-montserrat transition-all ${
            current === link.href || (link.href !== "/" && current.startsWith(link.href))
              ? "text-[#C09D4B] bg-gray-50"
              : "text-[#2D3A4A] hover:text-[#0F2440] hover:bg-gray-50"
          }`}
        >
          {link.label}
        </a>
      ))}
    </div>
    <div class="px-3 pb-3">
      <a href="/contact" class="block w-full py-3 bg-[#C09D4B] text-white rounded-lg text-sm font-black text-center font-montserrat uppercase tracking-wide hover:bg-[#D2B980] transition-colors">
        Partner With Us
      </a>
    </div>
  </div>
</header>

<script>
  const navbar = document.getElementById('navbar')!;
  const menuBtn = document.getElementById('menu-btn')!;
  const mobileMenu = document.getElementById('mobile-menu')!;
  const iconOpen = document.getElementById('icon-open')!;
  const iconClose = document.getElementById('icon-close')!;

  window.addEventListener('scroll', () => {
    if (window.scrollY > 20) {
      navbar.classList.add('shadow-md', 'py-2');
      navbar.classList.remove('py-3', 'py-4', 'border-b', 'border-[#E8E0D0]');
    } else {
      navbar.classList.remove('shadow-md', 'py-2');
      navbar.classList.add('py-3', 'md:py-4', 'border-b', 'border-[#E8E0D0]');
    }
  });

  menuBtn.addEventListener('click', () => {
    const isOpen = !mobileMenu.classList.contains('hidden');
    mobileMenu.classList.toggle('hidden');
    iconOpen.classList.toggle('hidden', !isOpen);
    iconClose.classList.toggle('hidden', isOpen);
  });

  // Close menu on nav link click
  mobileMenu.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      mobileMenu.classList.add('hidden');
      iconOpen.classList.remove('hidden');
      iconClose.classList.add('hidden');
    });
  });
</script>
