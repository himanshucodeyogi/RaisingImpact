---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Page Not Found" description="The page you're looking for doesn't exist.">
  <Navbar />

  <section id="main-content" class="min-h-screen bg-[#0F172A] flex items-center justify-center relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-[#10B981]/10 via-transparent to-[#3B82F6]/10"></div>
    <div class="absolute top-1/4 right-1/4 w-96 h-96 rounded-full border border-[#10B981]/10"></div>
    <div class="absolute bottom-1/4 left-1/4 w-64 h-64 rounded-full border border-[#3B82F6]/10"></div>

    <div class="relative z-10 text-center px-6">
      <div class="text-8xl md:text-9xl font-black text-transparent bg-clip-text bg-gradient-to-r from-[#10B981] to-[#3B82F6] mb-6 font-inter">404</div>
      <h1 class="text-3xl md:text-4xl font-black text-white mb-4">Page Not Found</h1>
      <p class="text-white/60 text-lg mb-10 max-w-md mx-auto leading-relaxed">
        The page you're looking for doesn't exist or has been moved.
      </p>
      <a href="/" class="inline-block px-8 py-4 bg-[#10B981] text-white font-bold rounded-2xl hover:bg-emerald-400 hover:scale-105 transition-all duration-200 shadow-lg shadow-emerald-500/30">
        Back to Home
      </a>
    </div>
  </section>

  <Footer />
</Layout>
