---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="About Us" description="Learn about Raising Impact's mission, methodology and journey in evidence-led philanthropy.">
  <Navbar />

  <!-- HERO — PPTX style dark navy + gold accent -->
  <section id="main-content" class="pt-36 pb-28 bg-[#0F2440] relative overflow-hidden">
    <div class="absolute right-0 top-0 h-full w-[40%] pptx-diagonal-bg pointer-events-none"></div>
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: linear-gradient(#C09D4B 1px, transparent 1px), linear-gradient(90deg, #C09D4B 1px, transparent 1px); background-size: 60px 60px;"></div>
    <div class="absolute left-0 top-0 h-full w-1.5 bg-gradient-to-b from-transparent via-[#C09D4B]/50 to-transparent"></div>

    <div class="relative z-10 max-w-7xl mx-auto px-6 md:px-12">
      <div class="flex items-center gap-3 mb-6">
        <div class="w-6 h-px bg-[#C09D4B]"></div>
        <span class="text-[#C09D4B] text-xs font-semibold uppercase tracking-[0.2em] font-montserrat">About Us</span>
      </div>
      <h1 class="text-5xl md:text-6xl font-black text-white max-w-3xl leading-tight mb-6">
        Bridging Intent &<br/><span class="text-[#C09D4B]">Measurable Outcomes</span>
      </h1>
      <p class="text-white/55 text-lg max-w-2xl leading-relaxed">
        We exist to close the gap between the desire to do good and the evidence of actually doing good — one rigorous research project at a time.
      </p>
    </div>
  </section>

  <!-- MISSION & VISION — Cream background, clean card grid -->
  <section class="py-24 bg-[#F9F6F0]">
    <div class="max-w-7xl mx-auto px-6 md:px-12">
      <div class="grid md:grid-cols-2 gap-16 items-center">
        <div class="fade-up">
          <div class="flex items-center gap-3 mb-6">
            <div class="w-6 h-px bg-[#C09D4B]"></div>
            <span class="text-[#C09D4B] text-xs font-semibold uppercase tracking-[0.2em] font-montserrat">Mission & Vision</span>
          </div>
          <h2 class="text-4xl font-black text-[#0F2440] mb-6">Why We Exist</h2>
          <p class="text-[#2D3A4A] leading-relaxed mb-5">
            India's philanthropic sector moves billions of rupees annually—yet a significant portion fails to create proportionate impact. Not due to lack of intent, but due to lack of rigour.
          </p>
          <p class="text-[#2D3A4A] leading-relaxed mb-5">
            <strong>Raising Impact</strong> was founded to change that narrative. We believe every charitable rupee deserves the rigour that every investment rupee demands.
          </p>
          <p class="text-[#2D3A4A] leading-relaxed">
            Our vision is a philanthropic ecosystem in India where decisions are guided by evidence, shaped by data, and measured for real-world outcomes.
          </p>
        </div>

        <div class="fade-up delay-200 grid grid-cols-2 gap-4">
          {[
            { num: "01", title: "Mission", text: "Provide rigorous, independent research that helps philanthropists direct capital toward high-impact causes." },
            { num: "02", title: "Vision", text: "An India where evidence-based giving becomes the norm, not the exception." },
            { num: "03", title: "Values", text: "Intellectual honesty, radical transparency, cost-consciousness, and genuine curiosity." },
            { num: "04", title: "Impact", text: "Proven methodologies that have helped philanthropists achieve 17x impact multiples." },
          ].map(item => (
            <div class="bg-white border border-[#E8E0D0] rounded-xl p-6 hover:border-[#C09D4B]/40 hover:shadow-md transition-all group">
              <div class="w-9 h-9 rounded-full border-2 border-[#C09D4B] flex items-center justify-center text-[#C09D4B] font-black text-xs mb-4 font-inter group-hover:bg-[#C09D4B] group-hover:text-white transition-all">{item.num}</div>
              <h4 class="font-black text-[#0F2440] mb-2 text-sm">{item.title}</h4>
              <p class="text-xs text-[#2D3A4A]/65 leading-relaxed">{item.text}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- METHODOLOGY — PPTX Slide 3 exact replica: 4 step cards in a row with connecting line -->
  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-6 md:px-12">
      <div class="text-center mb-16 fade-up">
        <div class="flex items-center justify-center gap-3 mb-4">
          <div class="w-6 h-px bg-[#C09D4B]"></div>
          <span class="text-[#C09D4B] text-xs font-semibold uppercase tracking-[0.2em] font-montserrat">Our Process</span>
          <div class="w-6 h-px bg-[#C09D4B]"></div>
        </div>
        <h2 class="text-4xl font-black text-[#0F2440] mb-4">The Methodology</h2>
        <p class="text-[#2D3A4A]/60 max-w-2xl mx-auto text-sm leading-relaxed">A systematic, four-phase approach to transforming philanthropic intent into verifiable social impact—adapted from GiveWell and Founders Pledge methods.</p>
      </div>

      <!-- 4 step cards with horizontal connecting line — PPTX slide 3 -->
      <div class="relative">
        <!-- Horizontal connecting line -->
        <div class="hidden md:block absolute top-10 left-[12.5%] right-[12.5%] h-px bg-gradient-to-r from-transparent via-[#C09D4B]/40 to-transparent z-0"></div>

        <div class="grid md:grid-cols-4 gap-6 relative z-10">
          {[
            {
              num: "01",
              title: "Cause-Area Research",
              items: ["Literature review & systematic research", "State & sector analyses", "Baseline metrics establishment", "Priority area identification"],
            },
            {
              num: "02",
              title: "Expert Engagement",
              items: ["Field interviews & primary data", "Expert network validation", "Implementation fidelity checks", "Feasibility assessments"],
            },
            {
              num: "03",
              title: "Structured Evaluation",
              items: ["Cost-effectiveness modeling", "Causal attribution analysis", "GiveWell/FP adapted methods", "Evidence quality grading"],
            },
            {
              num: "04",
              title: "Capital Deployment",
              items: ["Donor-org matching", "Evidence-backed recommendations", "Implementation roadmap", "Ongoing monitoring framework"],
            },
          ].map((phase, i) => (
            <div class={`fade-up delay-${(i+1)*100} bg-[#F9F6F0] border border-[#E8E0D0] rounded-xl p-6 hover:border-[#C09D4B]/50 hover:shadow-lg transition-all duration-300 group`}>
              <!-- Gold circle number — exact PPTX style -->
              <div class="w-12 h-12 rounded-full border-2 border-[#C09D4B] flex items-center justify-center text-[#C09D4B] font-black text-sm mb-6 font-inter mx-auto bg-white group-hover:bg-[#C09D4B] group-hover:text-white transition-all duration-300">{phase.num}</div>
              <h3 class="text-base font-black text-[#0F2440] mb-4 text-center">{phase.title}</h3>
              <ul class="space-y-2.5">
                {phase.items.map(item => (
                  <li class="flex items-start gap-2 text-xs text-[#2D3A4A]/65">
                    <div class="w-1 h-1 rounded-full bg-[#C09D4B] mt-1.5 flex-shrink-0"></div>
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- INSPIRATION — Dark navy, bordered cards -->
  <section class="py-24 bg-[#0F2440]">
    <div class="max-w-7xl mx-auto px-6 md:px-12">
      <div class="text-center mb-14 fade-up">
        <div class="flex items-center justify-center gap-3 mb-4">
          <div class="w-6 h-px bg-[#C09D4B]"></div>
          <span class="text-[#C09D4B] text-xs font-semibold uppercase tracking-[0.2em] font-montserrat">Standing on Giants' Shoulders</span>
          <div class="w-6 h-px bg-[#C09D4B]"></div>
        </div>
        <h2 class="text-4xl font-black text-white mb-4">Our Inspiration</h2>
        <p class="text-white/45 max-w-2xl mx-auto text-sm">We draw inspiration from global leaders in evidence-based philanthropy who have transformed how the world thinks about giving.</p>
      </div>

      <div class="grid md:grid-cols-2 gap-6">
        {[
          {
            org: "GiveWell",
            tagline: "Evidence-based charity evaluation",
            desc: "GiveWell's rigorous approach to identifying the most cost-effective charities globally inspired our methodology for evaluating philanthropic opportunities in the South Asian context.",
            url: "https://givewell.org"
          },
          {
            org: "Founders Pledge",
            tagline: "High-impact giving for entrepreneurs",
            desc: "Founders Pledge's model of research-backed giving guidance for high-net-worth individuals directly shaped how we approach our advisory practice for India's philanthropic ecosystem.",
            url: "https://founderspledge.com"
          }
        ].map((item, i) => (
          <div class={`fade-up delay-${(i+1)*100} bg-[#1E3A5A]/60 border border-white/10 rounded-xl p-8 hover:border-[#C09D4B]/40 transition-all`}>
            <div class="w-8 h-0.5 bg-[#C09D4B] mb-6"></div>
            <div class="flex items-center justify-between mb-5">
              <div>
                <h3 class="text-2xl font-black text-white">{item.org}</h3>
                <p class="text-[#C09D4B] text-xs font-medium font-montserrat uppercase tracking-widest mt-1">{item.tagline}</p>
              </div>
              <a href={item.url} target="_blank" class="w-10 h-10 bg-white/10 hover:bg-[#C09D4B] rounded-lg flex items-center justify-center transition-colors">
                <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
              </a>
            </div>
            <p class="text-white/55 text-sm leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- JOURNEY / TIMELINE -->
  <section class="py-24 bg-[#F9F6F0]">
    <div class="max-w-7xl mx-auto px-6 md:px-12">
      <div class="max-w-3xl mx-auto">
        <div class="fade-up text-center mb-14">
          <div class="flex items-center justify-center gap-3 mb-4">
            <div class="w-6 h-px bg-[#C09D4B]"></div>
            <span class="text-[#C09D4B] text-xs font-semibold uppercase tracking-[0.2em] font-montserrat">Our Journey</span>
            <div class="w-6 h-px bg-[#C09D4B]"></div>
          </div>
          <h2 class="text-4xl font-black text-[#0F2440]">Where It All Began</h2>
        </div>

        <div class="space-y-6">
          {[
            { year: "2021", title: "The Founding Insight", text: "Vikrant Bhargava and Luke Ding, with years of experience at Sattva and Veddis respectively, recognized the critical gap: India's philanthropic sector lacked rigorous, independent research to guide capital allocation.", active: false },
            { year: "2022", title: "ECCE Pilot Study", text: "Our landmark Early Childhood Care & Education (ECCE) pilot study across three Indian states. We evaluated 6 distinct ECCE interventions, measuring cognitive outcomes, cost-per-beneficiary, and scalability potential.", active: true },
            { year: "2023", title: "Scaling Advisory", text: "Expanded our advisory practice to include livelihoods, health, and environment sectors. Developed proprietary cost-effectiveness models tailored to the Indian philanthropic context.", active: false },
            { year: "2024", title: "Growing Impact", text: "Now advising 50+ philanthropists across India, with research cited by leading foundations. Our methodologies are now influencing sector-wide practices in evidence-based giving.", active: false },
          ].map((item, i) => (
            <div class={`fade-up delay-${(i+1)*100} flex gap-6`}>
              <div class="flex flex-col items-center">
                <div class={`w-12 h-12 rounded-full border-2 flex items-center justify-center text-xs font-black flex-shrink-0 font-inter transition-all ${item.active ? 'border-[#C09D4B] bg-[#C09D4B] text-white' : 'border-[#E8E0D0] bg-white text-[#2D3A4A]'}`}>{item.year}</div>
                {i < 3 && <div class="w-px h-6 bg-[#E8E0D0] mt-2"></div>}
              </div>
              <div class={`pb-6 flex-1 ${item.active ? 'bg-white border border-[#C09D4B]/20 rounded-xl p-5 -mt-1' : ''}`}>
                {item.active && <div class="w-6 h-0.5 bg-[#C09D4B] mb-3"></div>}
                <h4 class="font-black text-[#0F2440] mb-2">{item.title}</h4>
                <p class="text-sm text-[#2D3A4A]/65 leading-relaxed">{item.text}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .pptx-diagonal-bg {
    background: linear-gradient(
      150deg,
      transparent 0%,
      rgba(192, 157, 75, 0.04) 50%,
      rgba(192, 157, 75, 0.08) 100%
    );
    border-left: 1px solid rgba(192, 157, 75, 0.15);
  }
</style>

<script>
  const observer = new IntersectionObserver(
    (entries) => entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); observer.unobserve(e.target); } }),
    { threshold: 0.1 }
  );
  document.querySelectorAll('.fade-up').forEach(el => observer.observe(el));
</script>
