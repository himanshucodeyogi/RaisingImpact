---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import HeroCanvas from '../components/HeroCanvas.astro';
---

<Layout title="Home">
  <Navbar />

  <!-- HERO -->
  <section id="main-content" class="relative min-h-screen bg-[#0F172A] flex items-center overflow-hidden">
    <HeroCanvas />

    <!-- Gradient overlays -->
    <div class="absolute inset-0 bg-gradient-to-b from-[#0F172A]/30 via-transparent to-[#0F172A]"></div>
    <div class="absolute bottom-0 left-0 right-0 h-40 bg-gradient-to-t from-[#0F172A] to-transparent"></div>

    <div class="relative z-10 max-w-7xl mx-auto px-6 py-32">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 bg-[#10B981]/15 border border-[#10B981]/30 rounded-full px-4 py-2 mb-8">
          <div class="w-2 h-2 rounded-full bg-[#10B981] animate-pulse"></div>
          <span class="text-[#10B981] text-sm font-semibold font-montserrat">Evidence-Led Philanthropy Research</span>
        </div>

        <h1 class="text-5xl md:text-7xl font-black text-white leading-[1.08] mb-6">
          Guiding Philanthropy<br/>
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#10B981] to-[#3B82F6]">With Rigour.</span>
        </h1>

        <p class="text-lg md:text-xl text-white/70 mb-10 max-w-2xl leading-relaxed">
          Helping philanthropists maximize social impact through rigorous, data-driven research and evidence-based advisory.
        </p>

        <div class="flex flex-wrap gap-4">
          <a href="/contact" class="glow-btn px-8 py-4 bg-[#10B981] hover:bg-emerald-400 text-white font-bold rounded-2xl text-base shadow-lg shadow-emerald-500/30 transition-all duration-200 hover:scale-105">
            Partner With Us →
          </a>
          <a href="/about" class="px-8 py-4 border border-white/20 hover:border-white/50 text-white font-semibold rounded-2xl text-base backdrop-blur-sm hover:bg-white/10 transition-all duration-200">
            Our Approach
          </a>
        </div>
      </div>
    </div>

    <!-- Scroll indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-white/40 text-xs">
      <span>Scroll</span>
      <div class="w-px h-12 bg-gradient-to-b from-white/40 to-transparent animate-pulse"></div>
    </div>
  </section>

  <!-- STATS -->
  <section class="bg-[#0F172A] pb-24 pt-4">
    <div class="max-w-7xl mx-auto px-6">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
        {[
          { value: "17x", label: "Average Impact Multiple", icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>` },
          { value: "100%", label: "Evidence-Led Research", icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/></svg>` },
          { value: "50+", label: "Philanthropists Advised", icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>` },
          { value: "3+", label: "Years of Rigour", icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>` },
        ].map((stat, i) => (
          <div class={`fade-up delay-${(i+1)*100} bg-white/5 border border-white/10 rounded-2xl p-6 hover:border-[#10B981]/40 hover:bg-white/8 transition-all group`}>
            <div class="w-10 h-10 rounded-xl bg-[#10B981]/15 flex items-center justify-center text-[#10B981] mb-3" set:html={stat.icon}></div>
            <div class="text-3xl md:text-4xl font-black text-white mb-1 font-inter">{stat.value}</div>
            <div class="text-sm text-white/50 font-montserrat">{stat.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CORE APPROACH -->
  <section class="py-24 bg-[#F8FAFC]">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center mb-16 fade-up">
        <p class="text-[#10B981] font-semibold text-sm uppercase tracking-widest mb-3 font-montserrat">Our Core Approach</p>
        <h2 class="text-4xl md:text-5xl font-black text-[#0F172A]">How We Work</h2>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        {[
          {
            icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>`,
            title: "Analytically Rigorous",
            desc: "We apply the highest standards of research methodology—systematic reviews, cost-effectiveness analysis, and causal evidence—to every philanthropic decision we study.",
            color: "from-emerald-500/20 to-emerald-500/5"
          },
          {
            icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064"/></svg>`,
            title: "Regionally Rooted",
            desc: "Deep expertise in South Asian social contexts means our recommendations are grounded in local realities, not generic global frameworks. We understand the ground-level dynamics.",
            color: "from-blue-500/20 to-blue-500/5"
          },
          {
            icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`,
            title: "Cost-Effective",
            desc: "Every rupee counts. We help philanthropists identify high-leverage opportunities where charitable capital generates the greatest possible social return on investment.",
            color: "from-purple-500/20 to-purple-500/5"
          },
        ].map((card, i) => (
          <div class={`fade-up delay-${(i+1)*100} group bg-white rounded-3xl p-8 shadow-sm hover:shadow-xl border border-gray-100 hover:border-[#10B981]/30 transition-all duration-300`}>
            <div class={`w-14 h-14 rounded-2xl bg-gradient-to-br ${card.color} flex items-center justify-center text-[#10B981] mb-6 group-hover:scale-110 transition-transform`} set:html={card.icon}></div>
            <h3 class="text-xl font-bold text-[#0F172A] mb-3">{card.title}</h3>
            <p class="text-[#334155]/80 text-sm leading-relaxed">{card.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- LATEST INSIGHTS -->
  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-6">
      <div class="flex flex-col md:flex-row items-start md:items-center justify-between mb-14 gap-6">
        <div class="fade-up">
          <p class="text-[#10B981] font-semibold text-sm uppercase tracking-widest mb-3 font-montserrat">Research & Insights</p>
          <h2 class="text-4xl font-black text-[#0F172A]">Latest Reports</h2>
        </div>
        <a href="/about" class="fade-up text-[#10B981] font-semibold text-sm hover:underline flex items-center gap-1">View All Research →</a>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        {[
          {
            tag: "Education",
            title: "ECCE Pilot Study: Early Childhood Interventions in Rural India",
            date: "Dec 2024",
            readTime: "12 min read",
            excerpt: "Evaluating cost-effectiveness of Early Childhood Care & Education programs across three Indian states.",
            color: "bg-emerald-500"
          },
          {
            tag: "Health",
            title: "Maternal Health Outcomes Across Income Tiers",
            date: "Oct 2024",
            readTime: "9 min read",
            excerpt: "Analyzing intervention effectiveness for maternal healthcare programs in low-income urban settings.",
            color: "bg-blue-500"
          },
          {
            tag: "Livelihoods",
            title: "Skill Development ROI: A Cost-Benefit Analysis",
            date: "Aug 2024",
            readTime: "15 min read",
            excerpt: "Measuring the long-term economic returns of vocational training programs for rural youth.",
            color: "bg-purple-500"
          },
        ].map((card, i) => (
          <div class={`fade-up delay-${(i+1)*100} group bg-[#F8FAFC] rounded-3xl overflow-hidden hover:shadow-xl border border-gray-100 hover:border-[#10B981]/30 transition-all duration-300 cursor-pointer`}>
            <div class="h-48 bg-gradient-to-br from-[#0F172A] to-[#1e293b] relative flex items-end p-6">
              <div class="absolute inset-0 opacity-20">
                <div class="w-32 h-32 border border-[#10B981]/40 rounded-full absolute -top-8 -right-8"></div>
                <div class="w-20 h-20 border border-blue-400/40 rounded-full absolute bottom-4 left-8"></div>
              </div>
              <span class={`${card.color} text-white text-xs font-bold px-3 py-1 rounded-full relative z-10 font-montserrat`}>{card.tag}</span>
            </div>
            <div class="p-6">
              <div class="flex items-center gap-3 text-xs text-[#334155]/50 mb-3 font-inter">
                <span>{card.date}</span><span>·</span><span>{card.readTime}</span>
              </div>
              <h3 class="font-bold text-[#0F172A] mb-3 group-hover:text-[#10B981] transition-colors text-base leading-snug">{card.title}</h3>
              <p class="text-sm text-[#334155]/70 leading-relaxed">{card.excerpt}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA BANNER -->
  <section class="py-24 bg-[#0F172A] relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-[#10B981]/10 via-transparent to-[#3B82F6]/10"></div>
    <div class="absolute top-0 right-0 w-96 h-96 bg-[#10B981]/5 rounded-full -translate-y-1/2 translate-x-1/2"></div>
    <div class="relative z-10 max-w-3xl mx-auto px-6 text-center fade-up">
      <h2 class="text-4xl md:text-5xl font-black text-white mb-6">
        Ready to Maximize<br/><span class="text-[#10B981]">Your Social Impact?</span>
      </h2>
      <p class="text-white/60 text-lg mb-10 leading-relaxed">
        Join a growing community of thoughtful philanthropists who make evidence-based giving decisions.
      </p>
      <a href="/contact" class="glow-btn inline-block px-10 py-5 bg-[#10B981] text-white font-bold text-lg rounded-2xl shadow-xl shadow-emerald-500/30 hover:bg-emerald-400 hover:scale-105 transition-all duration-200">
        Start a Conversation →
      </a>
    </div>
  </section>

  <Footer />
</Layout>

<script>
  // Re-run scroll observer after page load
  const observer = new IntersectionObserver(
    (entries) => entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); observer.unobserve(e.target); } }),
    { threshold: 0.1 }
  );
  document.querySelectorAll('.fade-up').forEach(el => observer.observe(el));
</script>
