---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const teamMembers = [
  {
    name: "Vikrant Bhargava",
    role: "Co-Founder & Research Lead",
    background: "Ex-Sattva Consulting",
    bio: "Former senior consultant at Sattva with deep expertise in social sector strategy and impact measurement. Vikrant has led engagements with leading Indian foundations on evidence-based program design.",
    linkedin: "https://uk.linkedin.com/in/vikrant-bhargava",
    initials: "VB",
    color: "from-[#0F2440] to-[#1E3A5A]",
    image: "/vikrant.jpg"
  },
  {
    name: "Luke Ding",
    role: "Co-Founder & Advisory Lead",
    background: "Ex-Veddis Foundation",
    bio: "Previously at Veddis Foundation directing grant strategy and philanthropy advisory. Luke brings global perspective on cost-effective giving with specialized knowledge of South Asian development contexts.",
    linkedin: "https://www.linkedin.com/in/lukeding2288/",
    initials: "LD",
    color: "from-[#1E3A5A] to-[#203C55]",
    image: "/luke.jpg"
  },
  {
    name: "Rukmini Pandit",
    role: "Senior Research Analyst",
    background: "Ex-J-PAL South Asia",
    bio: "Alumna of J-PAL South Asia with expertise in RCT design and causal inference. Priya leads our quantitative research on education and early childhood interventions across India.",
    linkedin: "https://sg.linkedin.com/in/rukmini-pandit-b0b82b81",
    initials: "PS",
    color: "from-[#203C55] to-[#2A4A60]",
    image: "/Rukmini.png"
  },
  {
    name: "Murugan Vasudevan",
    role: "Policy Research Lead",
    background: "Ex-NITI Aayog Fellow",
    bio: "Former NITI Aayog fellow with specialized expertise in policy design and government partnership. Aryan bridges our research with government-scale implementation possibilities.",
    linkedin: "https://in.linkedin.com/in/muruganvasudevan",
    initials: "AM",
    color: "from-[#0F2440] to-[#3A6D9C]",
    image: "/murugan.png"
  },
  {
    name: "Tejaswini Vondivillu",
    role: "Data Science & Analytics",
    background: "Ex-McKinsey Digital",
    bio: "Quantitative analyst formerly at McKinsey's Digital practice. Sunaina builds the cost-effectiveness models and data pipelines that power our research methodology.",
    linkedin: "https://in.linkedin.com/in/tejaswini-vondivillu-308152198",
    initials: "SK",
    color: "from-[#1E3A5A] to-[#3A6D9C]",
    image: "/Tejaswini.png"
  },
  {
    name: "Ratish Balakrishnan",
    role: "Field Research Associate",
    background: "Ex-Aga Khan Foundation",
    bio: "Seasoned field researcher with Aga Khan Foundation background. Rahul leads primary data collection and community engagement for our ground-level studies across rural India.",
    linkedin: "https://in.linkedin.com/in/rathishbalakrishnan",
    initials: "RN",
    color: "from-[#203C55] to-[#0F2440]",
    image: "/Ratish.png"
  },
];
---

<Layout title="Our Team" description="Meet the researchers, analysts and advisors behind Raising Impact's evidence-led philanthropy work.">
  <Navbar />

  <!-- HERO -->
  <section id="main-content" class="pt-36 pb-28 bg-[#0F2440] relative overflow-hidden">

    <div class="absolute inset-0 opacity-[0.03]" style="background-image: linear-gradient(#C09D4B 1px, transparent 1px), linear-gradient(90deg, #C09D4B 1px, transparent 1px); background-size: 60px 60px;"></div>
    <div class="absolute left-0 top-0 h-full w-1.5 bg-gradient-to-b from-transparent via-[#C09D4B]/50 to-transparent"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-6 md:px-12 text-center">
      <div class="flex items-center justify-center gap-3 mb-6">
        <div class="w-6 h-px bg-[#C09D4B]"></div>
        <span class="text-[#C09D4B] text-xs font-semibold uppercase tracking-[0.2em] font-montserrat">Our Team</span>
        <div class="w-6 h-px bg-[#C09D4B]"></div>
      </div>
      <h1 class="text-5xl md:text-6xl font-black text-white mb-6 leading-tight">
        The People Behind<br/><span class="text-[#C09D4B]">The Research</span>
      </h1>
      <p class="text-white/55 text-lg max-w-2xl mx-auto leading-relaxed">
        A team of researchers, analysts, and policy experts dedicated to evidence-based social change across India.
      </p>
    </div>
  </section>

  <!-- CULTURE NOTE -->
  <section class="py-16 bg-[#F9F6F0] border-b border-[#E8E0D0]">
    <div class="max-w-7xl mx-auto px-6 md:px-12">
      <div class="flex flex-col md:flex-row items-center gap-10 fade-up">
        <div class="flex-1">
          <div class="w-6 h-0.5 bg-[#C09D4B] mb-5"></div>
          <h2 class="text-2xl font-black text-[#0F2440] mb-4">
            "A team of researchers and policy experts<br class="hidden md:block"/> dedicated to change."
          </h2>
          <p class="text-[#2D3A4A]/65 leading-relaxed">
            We are a deliberately small, senior team — every member brings irreplaceable domain expertise. We believe the best research comes from people who are obsessively curious, intellectually honest, and deeply committed to making the philanthropic sector more effective.
          </p>
        </div>
        <div class="flex flex-wrap gap-3 md:flex-col md:gap-3 md:min-w-[220px]">
          {["Research First", "Open Collaboration", "Evidence Wins", "No Sacred Cows"].map(v => (
            <div class="flex items-center gap-2 bg-white border border-[#E8E0D0] rounded-lg px-4 py-3">
              <div class="w-1.5 h-1.5 rounded-full bg-[#C09D4B]"></div>
              <span class="text-sm font-semibold text-[#2D3A4A] font-montserrat">{v}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- TEAM GRID -->
  <section class="py-24 bg-[#F9F6F0]">
    <div class="max-w-7xl mx-auto px-6 md:px-12">
      <div class="text-center mb-14 fade-up">
        <div class="flex items-center justify-center gap-3 mb-4">
          <div class="w-6 h-px bg-[#C09D4B]"></div>
          <span class="text-[#C09D4B] text-xs font-semibold uppercase tracking-[0.2em] font-montserrat">The Team</span>
          <div class="w-6 h-px bg-[#C09D4B]"></div>
        </div>
        <h2 class="text-4xl font-black text-[#0F2440]">Meet Our Researchers</h2>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {teamMembers.map((member, i) => (
          <div class={`fade-up delay-${((i % 3 + 1) * 100)} group bg-white border border-[#E8E0D0] rounded-xl overflow-hidden hover:border-[#C09D4B]/50 hover:shadow-lg transition-all duration-300`}>
            <!-- Avatar header -->
            <div class={`h-44 bg-gradient-to-br ${member.color} relative flex items-center justify-center overflow-hidden`}>
              <!-- Gold corner accent -->
              <div class="absolute top-0 left-0 w-12 h-0.5 bg-[#C09D4B]"></div>
              <div class="absolute top-0 left-0 h-12 w-0.5 bg-[#C09D4B]"></div>
              {member.image ? (
                <img src={member.image} alt={member.name} class="w-20 h-20 rounded-xl object-cover shadow-xl relative z-20 border-2 border-white/20" />
              ) : (
                <div class="w-20 h-20 rounded-xl bg-white/15 backdrop-blur-sm flex items-center justify-center shadow-xl relative z-20 border border-white/20">
                  <span class="text-white text-2xl font-black font-montserrat">{member.initials}</span>
                </div>
              )}
            </div>

            <div class="p-6">
              <div class="w-5 h-0.5 bg-[#C09D4B] mb-4"></div>
              <div class="flex items-start justify-between mb-1">
                <div>
                  <h3 class="font-black text-[#0F2440] text-base">{member.name}</h3>
                  <p class="text-[#C09D4B] text-xs font-semibold font-montserrat mt-0.5">{member.role}</p>
                </div>
                <a href={member.linkedin} target="_blank" aria-label={`${member.name} LinkedIn`}
                  class="w-8 h-8 border border-[#E8E0D0] hover:border-[#C09D4B] hover:text-[#C09D4B] text-[#2D3A4A]/50 rounded-lg flex items-center justify-center transition-all flex-shrink-0">
                  <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
                </a>
              </div>
              <div class="inline-block border border-[#C09D4B]/30 text-[#C09D4B] text-[10px] font-bold px-2.5 py-1 rounded mt-2 mb-3 font-montserrat uppercase tracking-wide">{member.background}</div>
              <p class="text-xs text-[#2D3A4A]/60 leading-relaxed">{member.bio}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- JOIN SECTION -->
  <section class="py-24 bg-[#0F2440] relative overflow-hidden">
    <div class="absolute right-0 top-0 h-full w-1.5 bg-gradient-to-b from-transparent via-[#C09D4B]/40 to-transparent"></div>
    <div class="absolute left-0 top-0 h-full w-1.5 bg-gradient-to-b from-transparent via-[#C09D4B]/60 to-transparent"></div>
    <div class="max-w-3xl mx-auto px-6 text-center fade-up">
      <div class="flex items-center justify-center gap-3 mb-6">
        <div class="w-10 h-px bg-[#C09D4B]/50"></div>
        <div class="w-2 h-2 rounded-full bg-[#C09D4B]"></div>
        <div class="w-10 h-px bg-[#C09D4B]/50"></div>
      </div>
      <div class="inline-block border border-[#C09D4B]/40 text-[#C09D4B] text-xs font-bold px-4 py-1.5 rounded-full mb-6 font-montserrat uppercase tracking-[0.2em]">Join Our Team</div>
      <h2 class="text-3xl md:text-4xl font-black text-white mb-6 leading-tight">
        Are You Obsessively Curious<br/>About Social Impact?
      </h2>
      <p class="text-white/50 leading-relaxed mb-8 max-w-xl mx-auto">
        We are always looking for sharp, mission-aligned researchers and analysts. If you believe data should drive philanthropy, we'd love to hear from you.
      </p>
      <a href="/contact" class="inline-block px-8 py-4 bg-[#C09D4B] text-white font-black rounded-lg hover:bg-[#D2B980] hover:scale-105 transition-all duration-200 shadow-lg shadow-[#C09D4B]/20 font-montserrat uppercase tracking-wide text-sm">
        Get In Touch →
      </a>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .pptx-diagonal-bg {
    background: linear-gradient(
      150deg,
      transparent 0%,
      rgba(192, 157, 75, 0.04) 50%,
      rgba(192, 157, 75, 0.08) 100%
    );
    border-left: 1px solid rgba(192, 157, 75, 0.15);
  }
</style>

<script>
  const observer = new IntersectionObserver(
    (entries) => entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); observer.unobserve(e.target); } }),
    { threshold: 0.1 }
  );
  document.querySelectorAll('.fade-up').forEach(el => observer.observe(el));
</script>
